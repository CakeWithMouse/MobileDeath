<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../UnityPart/PancakeCooker/Assets/Blinopek/Domain/*.cs" />
    <Compile Include="../../UnityPart/PancakeCooker/Assets/Blinopek/Application/*.cs" />
    <Compile Include="../../UnityPart/PancakeCooker/Assets/Blinopek/Infrastructure/LocalDevelopmentGateway.cs" />
